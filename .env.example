# Copy this file to .env (git-ignored) and fill in your own values.
# Used by .mcp.json to start the GitLab MCP server (gitlab-publisher agent only —
# no other agent in this pipeline has GitLab access).

# Your PERSONAL GitLab access token (Settings > Access Tokens), scope: api.
# Bugs/releases get filed as YOU, not a shared bot — each teammate sets their own.
GITLAB_PERSONAL_ACCESS_TOKEN=

# Your GitLab instance's API base URL, e.g.:
#   https://gitlab.com/api/v4                 (GitLab SaaS)
#   https://gitlab.your-company.com/api/v4    (self-managed)
GITLAB_API_URL=
