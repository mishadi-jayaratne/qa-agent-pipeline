# Per-project generated output — this pipeline is meant to be reused across projects,
# so the artifacts it produces for any one project shouldn't be committed to the pipeline repo.
output/*
!output/.gitkeep
!output/test-cases/.gitkeep
!output/rca/.gitkeep
!output/bugs/.gitkeep

# If you cloned this pipeline INSIDE a project repo and want output/ committed as part of
# that project's own history instead, delete this .gitignore (or the output/ rule above).

# Per-teammate secrets for the gitlab-publisher agent's MCP server (personal GitLab token +
# instance URL). Never commit real values — copy .env.example to .env and fill in your own.
.env

# Local dashboard run logs — raw Claude Code session transcripts (token usage, cwd, etc.) for
# whatever project --project-dir last pointed at. Never meant to be committed.
dashboard/logs/
